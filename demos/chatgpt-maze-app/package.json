{
  "name": "webmcp-maze-app", "version": "1.0.0", "private": true, "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && npm run build -w @maze/ui && vite build --config apps/web/vite.config.ts && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@maze/core=./packages/maze-core/src/index.ts --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "agent:smoke": "tsx scripts/agent-smoke.ts"
  },
  "dependencies": {"@modelcontextprotocol/sdk": "^1.20.2", "@modelcontextprotocol/ext-apps": "^1.0.1", "react": "^19.0.0", "react-dom": "^19.0.0", "zod": "^3.25.76"},
  "devDependencies": {"@playwright/test": "^1.56.0", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "esbuild": "^0.25.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.0.0", "vite-plugin-singlefile": "^2.3.0", "vitest": "^3.2.0", "webmcp-types": "^0.1.6"}
}
