{
  "name": "webmcp-maze",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.widget.config.ts && npm run build:pixel",
    "test": "vitest run src/__tests__",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:web": "tsc && vite build",
    "start": "node --import tsx server/index.ts",
    "local:start": "node scripts/local-runtime.mjs start",
    "local:status": "node scripts/local-runtime.mjs status",
    "build:pixel": "tsc -p pixel-art/tsconfig.json && vite build --config vite.pixel.config.ts",
    "dev:pixel": "vite --config vite.pixel.config.ts --host 127.0.0.1 --port 8790 --strictPort"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.10"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pixi.js": "^8.16.0",
    "zod": "^4.6.7"
  }
}
